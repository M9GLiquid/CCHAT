{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open Terminals",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Server",
        "Client 1",
        "Client 2",
        "Git Terminal"
      ],
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1,
        "instancePolicy": "silent"
      },
      "problemMatcher": []
    },
    {
      "label": "Server",
      "type": "shell",
      "command": "echo 'Server ready'; exec bash -l",
      "isBackground": true,
      "problemMatcher": [],
      "promptOnClose": false,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "icon": {
        "id": "terminal",
        "color": "terminal.ansiYellow"
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "group": "cchat-main",
        "showReuseMessage": false,
        "preserveTerminalName": true
      },
      "linux": {
        "options": {
          "shell": {
            "executable": "/bin/bash",
            "args": [
              "-lc"
            ]
          }
        }
      }
    },
    {
      "label": "Client 1",
      "type": "shell",
      "command": "echo 'Client ready'; exec bash -l",
      "isBackground": true,
      "problemMatcher": [],
      "promptOnClose": false,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "icon": {
        "id": "comment-discussion",
        "color": "terminal.ansiCyan"
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "group": "cchat-main",
        "showReuseMessage": false,
        "preserveTerminalName": true
      },
      "linux": {
        "options": {
          "shell": {
            "executable": "/bin/bash",
            "args": [
              "-lc"
            ]
          }
        }
      }
    },
    {
      "label": "Client 2",
      "type": "shell",
      "command": "echo 'Client ready'; exec bash -l",
      "isBackground": true,
      "problemMatcher": [],
      "promptOnClose": false,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "icon": {
        "id": "comment-discussion",
        "color": "terminal.ansiCyan"
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "group": "cchat-main",
        "showReuseMessage": false,
        "preserveTerminalName": true
      },
      "linux": {
        "options": {
          "shell": {
            "executable": "/bin/bash",
            "args": [
              "-lc"
            ]
          }
        }
      }
    },
    {
      "label": "Git Terminal",
      "type": "shell",
      "command": "echo 'Git terminal ready'; exec bash -l",
      "isBackground": true,
      "problemMatcher": [],
      "promptOnClose": false,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "icon": {
        "id": "github",
        "color": "terminal.ansiRed"
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "group": "cchat-git",
        "showReuseMessage": false,
        "preserveTerminalName": true
      },
      "linux": {
        "options": {
          "shell": {
            "executable": "/bin/bash",
            "args": [
              "-lc"
            ]
          }
        }
      }
    },
    {
      "label": "Setup Ubuntu C toolchain",
      "type": "shell",
      "command": "bash",
      "args": [
        "./scripts/setup_ubuntu.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Meson: Build Server",
      "type": "shell",
      "command": "meson",
      "args": [
        "setup",
        "Build",
        "-Dbuild_server=true",
        "-Dbuild_client=false"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Meson: Build Server & Client",
      "type": "shell",
      "command": "meson",
      "args": [
        "setup",
        "Build",
        "-Dbuild_server=true",
        "-Dbuild_client=true"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build"
      },
      "problemMatcher": []
    },
    {
      "label": "Meson: Build Client",
      "type": "shell",
      "command": "meson",
      "args": [
        "setup",
        "Build",
        "-Dbuild_server=false",
        "-Dbuild_client=true"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Meson: Compile",
      "type": "shell",
      "command": "meson",
      "args": [
        "compile",
        "-C",
        "Build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Meson: Wipe",
      "type": "shell",
      "command": "meson",
      "args": [
        "setup",
        "Build",
        "\u002d\u002dwipe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}