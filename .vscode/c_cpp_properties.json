{
  "version": 4,
  "configurations": [
    {
      "name": "Linux",
      "cStandard": "c17",
      "intelliSenseMode": "linux-gcc-x64",
      "compileCommands": "${workspaceFolder}/builddir/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/src/**",
        "${workspaceFolder}/third_party/wsl-headers/ubuntu24/include/**"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/src",
          "${workspaceFolder}/third_party/wsl-headers/ubuntu24/include"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}